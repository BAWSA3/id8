# Server-only. Never expose to the client.
ANTHROPIC_API_KEY=
NANSEN_API_KEY=

# Supabase (the desk). Anon key is public by design; RLS gates everything.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The record (lead capture). PUBLISHABLE / anon key only, never the secret: the table is insert-only under RLS.
# Names differ from NEXT_PUBLIC_SUPABASE_* on purpose so the desk's sign-in path stays off.
LEADS_SUPABASE_URL=
LEADS_SUPABASE_KEY=

# optional: a CoinGecko demo key lifts the keyless rate limit on the native-coin market row (ETH, SOL, BTC)
COINGECKO_API_KEY=
